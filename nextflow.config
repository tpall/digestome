manifest {
    name            = 'digestome'
    description     = 'Licence-clean functional profiling of anaerobic digestion microbiomes'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0'
}

params {
    // inputs
    genomes     = null                  // glob of genome FASTA; genes called with Prodigal
    proteomes   = null                  // glob of *.faa, one per genome/MAG
    input       = null                  // or a CSV: sample,faa
    db          = null                  // database root holding ad_panel/

    // panel assets: bundled defaults, overridable
    panel       = "${projectDir}/assets/AD_methanogenesis_panel.tsv"
    secretion   = "${projectDir}/assets/secretion_modules.tsv"
    gtdbtk      = null                  // GTDB-Tk summary.tsv; see the warning in main.nf

    // reporting
    sample_name = 'sample'
    description = ''
    outdir      = 'results'
    help        = false

    // Tools are taken from PATH by default, which is what the setup scripts assume
    // (module load hmmer). The conda and container profiles override that.
    // 11 is the standard bacterial/archaeal table. It truncates pyrrolysine
    // proteins at the amber codon; the fragments still clear the curated cutoffs.
    translation_table = 11

    hmmer_container  = 'quay.io/biocontainers/hmmer:3.3.2--hdbdd923_1'
    prodigal_container = 'quay.io/biocontainers/prodigal:2.6.3--h031d066_8'
    python_container = 'python:3.11-slim'
}

process {
    errorStrategy = { task.exitStatus in [104,134,137,139,143,247] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_single { cpus = 1; memory = { 2.GB  * task.attempt }; time = { 2.h * task.attempt } }
    withLabel: process_low    { cpus = 2; memory = { 4.GB  * task.attempt }; time = { 4.h * task.attempt } }
}

profiles {
    standard { process.executor = 'local' }

    slurm {
        process.executor = 'slurm'
        // Site-specific and deliberately unset: pass with
        //   -profile slurm --partition <p>   or export SBATCH_PARTITION/SBATCH_ACCOUNT
        process.queue    = System.getenv('SBATCH_PARTITION') ?: null
        process.clusterOptions = System.getenv('SBATCH_ACCOUNT') ? "-A ${System.getenv('SBATCH_ACCOUNT')}" : null
    }

    conda {
        conda.enabled = true
        process {
            withName: PRODIGAL { conda = 'bioconda::prodigal=2.6.3' }
            withName: HMMSEARCH { conda = 'bioconda::hmmer=3.3.2' }
            withName: 'SCORE|AGGREGATE' { conda = 'conda-forge::python=3.11' }
        }
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process {
            withName: PRODIGAL { container = params.prodigal_container }
            withName: HMMSEARCH { container = params.hmmer_container }
            withName: 'SCORE|AGGREGATE' { container = params.python_container }
        }
    }

    docker {
        docker.enabled = true
        process {
            withName: PRODIGAL { container = params.prodigal_container }
            withName: HMMSEARCH { container = params.hmmer_container }
            withName: 'SCORE|AGGREGATE' { container = params.python_container }
        }
    }

    // Exercises the DAG with no tools, data or database present.
    test {
        params.proteomes = "${projectDir}/tests/stub/*.faa"
        params.db        = "${projectDir}/tests/stub/db"
        params.sample_name = 'stub run'
    }
}

// Provenance. The 26.x strict config parser rejects variable declarations here,
// so these are static names. For a per-run history, pass shell-expanded names from
// the launcher instead, e.g.
//   nextflow run . -with-trace logs/trace-$(date +%s).txt
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }

// onComplete lives here rather than in main.nf: the 26.x strict parser rejects
// top-level statements in a script file. Uses println because `log` is not in
// scope for a config-defined handler.
workflow.onComplete = {
    println(workflow.success
        ? "digestome finished. Profile: ${params.outdir}/profile.txt"
        : "digestome did not complete successfully.")
}
