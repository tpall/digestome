digraph G {
  rankdir=LR; newrank=true; nodesep=0.25; ranksep=0.55;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, margin="0.12,0.06"];
  edge [color="#6D7173", arrowsize=0.6];
  subgraph cluster_1 { label="Before the sample"; fontname="Helvetica"; fontsize=12; color="#BBBBBB"; style="rounded";
  state_0 [label="Reactor state\nbefore", fillcolor="#FFFFFF", color="#6D7173", style="rounded,dashed,filled"];
  comm_0 [label="Community\nbefore", fillcolor="#FFFFFF", color="#6D7173", style="rounded,dashed,filled"];
  dna_0 [label="Previous\nprofile", fillcolor="#E69F00", color="#9C6A00", fontcolor="#000000", penwidth=2];
  }
  subgraph cluster_2 { label="Levers and design"; fontname="Helvetica"; fontsize=12; color="#BBBBBB"; style="rounded";
  feed [label="Feed mix\n(protein, fibre, fat)", fillcolor="#E8F1F8", color="#0072B2"];
  olr [label="Loading rate", fillcolor="#E8F1F8", color="#0072B2"];
  hrt [label="Retention time", fillcolor="#E8F1F8", color="#0072B2"];
  temp [label="Temperature", fillcolor="#E8F1F8", color="#0072B2"];
  te_dose [label="Trace-element\ndosing", fillcolor="#E8F1F8", color="#0072B2"];
  inoc [label="Inoculum", fillcolor="#E8F1F8", color="#0072B2"];
  air [label="Air dosing\n(desulphurisation)", fillcolor="#E8F1F8", color="#0072B2"];
  reactor [label="Reactor type,\nmixing, stages", fillcolor="#F2F2F2", color="#6D7173"];
  }
  subgraph cluster_3 { label="Reactor at sampling (not observed directly)"; fontname="Helvetica"; fontsize=12; color="#BBBBBB"; style="rounded";
  te [label="Trace elements\nin the digester", fillcolor="#FFFFFF", color="#6D7173", style="rounded,dashed,filled"];
  acceptor [label="Sulfate, nitrate,\noxygen", fillcolor="#FFFFFF", color="#6D7173", style="rounded,dashed,filled"];
  state [label="Reactor state\n(VFA, H2, NH3, pH)", fillcolor="#FFFFFF", color="#6D7173", style="rounded,dashed,filled"];
  comm [label="Community\n(who carries what)", fillcolor="#FFF4E0", color="#E69F00", style="rounded,dashed,filled", penwidth=2];
  }
  subgraph cluster_4 { label="What is measured"; fontname="Helvetica"; fontsize=12; color="#BBBBBB"; style="rounded";
  sampling [label="Sampling point\nand time", fillcolor="#F2F2F2", color="#6D7173"];
  extract [label="DNA extraction,\nsequencing depth", fillcolor="#F2F2F2", color="#6D7173"];
  ref [label="Reference genomes\n(GTDB or own MAGs)", fillcolor="#F2F2F2", color="#6D7173"];
  dna [label="Marker-gene profile\n(genome shares)", fillcolor="#E69F00", color="#9C6A00", fontcolor="#000000", penwidth=2];
  proc [label="Process data\n(FOS/TAC, VFA, NH4, pH)", fillcolor="#E3F2EC", color="#009E73"];
  te_meas [label="Trace-element\nanalysis", fillcolor="#E3F2EC", color="#009E73"];
  gas [label="Gas yield, CH4 %", fillcolor="#E3F2EC", color="#009E73"];
  cue [label="What the operator\nsees on site (foam, smell)", fillcolor="#FFFFFF", color="#0072B2", style="rounded,dashed,filled"];
  }
  subgraph cluster_5 { label="Which samples exist"; fontname="Helvetica"; fontsize=12; color="#BBBBBB"; style="rounded";
  goodday [label="Sample on a\nstable day", fillcolor="#F2F2F2", color="#6D7173"];
  sampled [label="A sample\nis taken", fillcolor="#FFFFFF", color="#CC79A7", shape=octagon, style="filled"];
  }
  subgraph cluster_6 { label="Next interval"; fontname="Helvetica"; fontsize=12; color="#BBBBBB"; style="rounded";
  decision [label="Operator's next\nchange (load, feed)", fillcolor="#E8F1F8", color="#0072B2"];
  state_1 [label="Reactor state,\nnext interval", fillcolor="#FBE7E1", color="#D55E00", style="rounded,dashed,filled"];
  proc_1 [label="Process data,\nnext interval", fillcolor="#E3F2EC", color="#009E73"];
  }
  feed -> state;
  olr -> state;
  hrt -> state;
  temp -> state;
  te -> state;
  acceptor -> state;
  state_0 -> state;
  comm_0 -> state;
  feed -> te;
  te_dose -> te;
  feed -> acceptor;
  air -> acceptor;
  comm_0 -> comm;
  feed -> comm;
  state -> comm;
  temp -> comm;
  hrt -> comm;
  te -> comm;
  acceptor -> comm;
  inoc -> comm;
  reactor -> hrt;
  reactor -> comm;
  reactor -> sampling;
  comm -> dna [color="#9C6A00", penwidth=1.6];
  sampling -> dna [color="#9C6A00", penwidth=1.6];
  extract -> dna [color="#9C6A00", penwidth=1.6];
  ref -> dna [color="#9C6A00", penwidth=1.6];
  state -> proc;
  te -> te_meas;
  comm -> gas;
  state -> gas;
  proc -> decision;
  dna -> decision;
  gas -> decision;
  state -> cue;
  cue -> decision;
  state -> sampled;
  goodday -> sampled;
  dna_0 -> sampled;
  comm_0 -> dna_0;
  state_1 -> proc_1;
  state -> state_1;
  comm -> state_1;
  decision -> state_1;
}
